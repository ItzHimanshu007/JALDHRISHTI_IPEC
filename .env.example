# =============================================
# Jal Drishti - Environment Configuration
# =============================================
# Copy this file to .env and customize values

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR

# Weather API (Open-Meteo - no key needed)
WEATHER_CACHE_TTL=600    # seconds

# Vercel Deployment (set in CI/CD secrets)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Sarvam AI Voice (Settings > Voice Language, report/grid reading)
# Get a key from https://www.sarvam.ai - never commit a real key.
# Without this set, /api/voice/speak returns a 503 and the frontend shows
# a "voice service unavailable" message instead of failing silently.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_SPEAKER=shubh
